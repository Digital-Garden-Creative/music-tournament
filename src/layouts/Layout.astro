---
import '../styles/global.css';
interface Props { title?: string }
const { title = 'Song Tournament' } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Everyone picks songs from their own phone, then the group votes them head-to-head through a bracket until one is crowned champion." />
    <meta name="theme-color" content="#09090b" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-full bg-zinc-950 text-zinc-100 antialiased selection:bg-fuchsia-500/30">
    <div class="flex min-h-screen flex-col">
      <main class="flex-1">
        <slot />
      </main>
      <footer class="border-t border-zinc-800/80 px-6 py-5">
        <div class="mx-auto flex max-w-5xl items-center justify-between text-sm text-zinc-500">
          <span>© 2026 sduemler</span>
          <a
            href="https://github.com/sduemler"
            target="_blank"
            rel="noopener noreferrer"
            class="text-zinc-500 transition-colors hover:text-fuchsia-400"
            aria-label="GitHub"
          >
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.05-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.39 1.24-3.23-.12-.31-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.18.77.84 1.24 1.92 1.24 3.23 0 4.62-2.81 5.64-5.49 5.94.43.37.81 1.1.81 2.22 0 1.61-.01 2.9-.01 3.29 0 .32.21.7.82.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z" />
            </svg>
          </a>
        </div>
      </footer>
    </div>
  </body>
</html>
