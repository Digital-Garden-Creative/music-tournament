# Copy to .env and fill in from your Supabase project (Project Settings → API).
# PUBLIC_ vars are exposed to the browser — only ever the anon key here.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used ONLY by the local rip worker (worker/.env), never the web app. Keep secret.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
